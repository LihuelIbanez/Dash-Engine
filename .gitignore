# Build directories
build/
build*/

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json

# Binaries
*.o
*.a
*.dylib

# ImGui layout state
imgui.ini

# Runtime logs
*.logcd

# Asset import cache (regenerable from assets/ via the import pipeline).
# The per-project SQLite db lives here too and mutates on every editor run.
library/*
!library/.gitkeep
.library/

# macOS
.DS_Store


# Baked model artifacts: regenerate with the dash_bake_model tool.
#   cmake --build build --target dash_bake_model
#   ./build/tests/dash_bake_model assets/models/gltf/<model>.gltf
*.dashmesh
*.dashskel
*.dashanim
