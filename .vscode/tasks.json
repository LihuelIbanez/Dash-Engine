{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "dash-editor-build",
            "type": "shell",
            "command": "cmake -S \"${workspaceFolder}\" -B \"${workspaceFolder}/build\" -DCMAKE_EXPORT_COMPILE_COMMANDS=ON && cmake --build \"${workspaceFolder}/build\" --target DashEngine --parallel",
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": true },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}
